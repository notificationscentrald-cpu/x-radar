{
  "manifest_version": 3,
  "name": "X Radar: X-фактор у стрічці",
  "version": "1.0.0",
  "description": "Показує під кожним постом в X його X-фактор: перегляди / підписники автора.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["xfactor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "css": ["xfactor.css"],
      "run_at": "document_start"
    }
  ]
}
